# Public browser-visible API origin; do not put secrets in NEXT_PUBLIC variables.
NEXT_PUBLIC_API_BASE_URL=http://localhost:3001

# Operator-verified production HTTPS origin only. Leave unset for previews.
# EAZICART_SITE_URL=
# Enable public acquisition indexing only after production/domain verification.
EAZICART_INDEXING=false
# Enable catalog indexing only after confirming this is genuine production data.
EAZICART_CATALOG_INDEXING=false
# Optional server-reachable URL for the SAME existing public Fastify API.
# EAZICART_PUBLIC_API_URL=
