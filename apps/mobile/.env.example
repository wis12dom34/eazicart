EXPO_PUBLIC_EAZICART_API_BASE_URL=https://eazicart.com/api
# Development only: replace with your staging API for isolated tests.

# OPTIONAL: Development-only reconciliation audit preview.
# Never use eazicart.com, live credentials, or customer records here.
# These preview routes are not available on a deployed backend yet.
EXPO_PUBLIC_EAZICART_ENABLE_ADMIN_AUDIT_PREVIEW=0
# EXPO_PUBLIC_EAZICART_ADMIN_AUDIT_PREVIEW_BASE_URL=https://local-staging.test/api
# Paste a separate disposable staging ADMIN bearer token inside the dev UI.
# NEVER put any bearer token or KoraPay secret in an EXPO_PUBLIC variable.
