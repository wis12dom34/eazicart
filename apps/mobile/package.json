  "main": "expo-router/entry",
  "dependencies": {
    "@expo/ui": "~58.0.27",
    "@expo/vector-icons": "^15.0.3",
    "@tanstack/react-query": "^5.90.0",
    "expo": "~58.0.23",
    "expo-constants": "~58.0.15",
    "expo-crypto": "~58.0.7",
    "expo-dev-client": "~58.0.18",
    "expo-device": "~58.0.5",
    "expo-font": "~58.0.11",
    "expo-glass-effect": "~58.0.5",
    "expo-haptics": "~58.0.7",
    "expo-image": "~58.0.18",
    "expo-linking": "~58.0.16",
    "expo-router": "~58.0.30",
    "expo-secure-store": "~58.0.2",
    "expo-splash-screen": "~58.0.13",
    "expo-status-bar": "~58.0.4",
    "expo-symbols": "~58.0.4",
    "expo-system-ui": "~58.0.7",
    "expo-video": "~58.0.13",
    "expo-web-browser": "~58.0.7",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.1",
    "react-native-gesture-handler": "~3.3.0",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-screens": "~4.30.1",
    "react-native-web": "~0.21.4",
    "react-native-worklets": "0.13.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.4",
    "@types/react": "~19.3.0",
    "eslint": "^9.35.0",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start --dev-client",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src --max-warnings=0",
    "test": "EXPO_PUBLIC_EAZICART_API_BASE_URL=https://fixture.invalid/api tsx --test tests/*.test.ts",
    "export:android": "expo export --platform android --output-dir dist-android",
    "export:ios": "expo export --platform ios --output-dir dist-ios",
    "test:live:read-only": "node tests/live-readonly-smoke.mjs",
    "verify:prebuild": "node scripts/native-prebuild-verify.mjs",
    "test:prebuild": "node --test scripts/native-prebuild-verify.test.mjs",
    "eas-build-pre-install": "node scripts/native-build-profile-verify.mjs",
    "verify:build-profile": "node scripts/native-build-profile-verify.mjs",
    "test:build-profile": "node --test scripts/native-build-profile-verify.test.mjs",
    "verify:ios-runner": "node scripts/ios-runner-readiness.mjs",
    "test:ios-runner": "node --test scripts/ios-runner-readiness.test.mjs"
  },
  "private": true
}
