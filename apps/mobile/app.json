{
  "expo": {
    "name": "EaziCart",
    "slug": "eazicart-native",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "eazicart",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.eazicart.mobile.dev",
      "icon": "./assets/images/icon.png"
    },
    "android": {
      "package": "com.eazicart.mobile.dev",
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF",
        "foregroundImage": "./assets/images/android-icon-foreground.png"
      }
    },
    "web": {
      "output": "server",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FFFFFF",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 110
        }
      ],
      "expo-video"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "backgroundColor": "#FFFFFF"
  }
}
