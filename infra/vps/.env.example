# Copy to .env on the EaziCart VPS only. Never commit populated secrets.
API_IMAGE=eazicart-api:release-1
API_DOMAIN=api.example.com
ACME_EMAIL=owner@example.com
WEB_ORIGIN=https://app.example.com
# Generate separately with: openssl rand -hex 32
# Use hexadecimal passwords so DATABASE_URL does not need URL escaping.
POSTGRES_PASSWORD=
JWT_SECRET=
