generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  BUYER
  SELLER
  ADMIN
}
enum OrderStatus {
  PENDING
  CONFIRMED
  FULFILLED
  CANCELLED
}
enum PaymentStatus {
  PENDING
  SUCCESS
  FAILED
  REVIEW_REQUIRED
}
enum SellerFulfillmentStatus {
  PENDING
  CONFIRMED
  FULFILLED
  CANCELLED
}
enum SellerPlanCode {
  BASIC
  PRO
  BUSINESS
}
enum SellerSubscriptionStatus {
  PENDING
  ACTIVE
  CANCELLED
  EXPIRED
}
enum CampaignObjective {
  PRODUCT_VIEWS
  STORE_VISITS
  ORDERS
  FOLLOWERS
}
enum CampaignStatus {
  DRAFT
  SCHEDULED
  ACTIVE
  PAUSED
  COMPLETED
  CANCELLED
}
enum NotificationType {
  ORDER
  SYSTEM
  SOCIAL
}
enum ReelSource {
  EAZICART
  YOUTUBE
  TIKTOK
  PARTNER
}
enum ReelStatus {
  DRAFT
  PUBLISHED
  HIDDEN
}

model User {
  id String @id @default(cuid())
  email String @unique
  passwordHash String
  name String
  role UserRole @default(BUYER)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  refreshTokens RefreshToken[]
  sellerProfile SellerProfile?
  cart Cart?
  orders Order[]
  addresses Address[]
  savedProducts SavedProduct[]
  following Follow[] @relation("Follower")
  followers Follow[] @relation("SellerFollowers")
  notifications Notification[]
  reelLikes ReelLike[]
  reelSaves ReelSave[]
  reelViews ReelView[]
  reelComments ReelComment[]
}

model RefreshToken {
  id String @id @default(cuid())
  tokenHash String @unique
  expiresAt DateTime
  revokedAt DateTime?
  userId String
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  @@index([userId])
}

model SellerProfile {
  id String @id @default(cuid())
  displayName String
  bio String?
  userId String @unique
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  products Product[]
  fulfillments SellerFulfillment[]
  subscriptions SellerSubscription[]
  campaigns Campaign[]
  reels Reel[]
}

model Category {
  id String @id @default(cuid())
  name String @unique
  slug String @unique
  products Product[]
}

model Product {
  id String @id @default(cuid())
  name String
  description String?
  price Decimal @db.Decimal(12, 2)
  stock Int @default(0)
  active Boolean @default(true)
  sellerId String
  categoryId String
  seller SellerProfile @relation(fields: [sellerId], references: [id])
  category Category @relation(fields: [categoryId], references: [id])
  images ProductImage[]
  cartItems CartItem[]
  orderItems OrderItem[]
  savedBy SavedProduct[]
  campaigns Campaign[]
  reels Reel[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([active, createdAt])
  @@index([categoryId, active])
  @@index([sellerId, active])
}

model ProductImage {
  id String @id @default(cuid())
  url String
  altText String?
  position Int @default(0)
  productId String
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
}

model Cart {
  id String @id @default(cuid())
  userId String @unique
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  items CartItem[]
  updatedAt DateTime @updatedAt
}

model CartItem {
  id String @id @default(cuid())
  quantity Int
  cartId String
  productId String
  cart Cart @relation(fields: [cartId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id])
  @@unique([cartId, productId])
}

model Order {
  id String @id @default(cuid())
  status OrderStatus @default(PENDING)
  total Decimal @db.Decimal(12, 2)
  userId String
  addressId String
  user User @relation(fields: [userId], references: [id])
  address Address @relation(fields: [addressId], references: [id])
  items OrderItem[]
  fulfillments SellerFulfillment[]
  payment Payment?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([userId, createdAt])
}

model OrderItem {
  id String @id @default(cuid())
  quantity Int
  unitPrice Decimal @db.Decimal(12, 2)
  productName String
  orderId String
  productId String
  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id])
}

model Payment {
  id String @id @default(cuid())
  provider String @default("PAYSTACK")
  reference String @unique
  status PaymentStatus @default(PENDING)
  amount Decimal @db.Decimal(12, 2)
  currency String @default("NGN")
  authorizationUrl String?
  accessCode String?
  providerTransactionId String?
  failureReason String?
  paidAt DateTime?
  orderId String @unique
  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([status, createdAt])
}

model SellerFulfillment {
  id String @id @default(cuid())
  status SellerFulfillmentStatus @default(PENDING)
  orderId String
  sellerId String
  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
  seller SellerProfile @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@unique([orderId, sellerId])
  @@index([sellerId, status])
  @@index([orderId])
}

model SellerPlan {
  code SellerPlanCode @id
  name String
  monthlyPrice Decimal? @db.Decimal(12, 2)
  productLimit Int?
  campaignLimit Int?
  advancedAnalytics Boolean?
  published Boolean @default(false)
  displayOrder Int
  subscriptions SellerSubscription[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([published, displayOrder])
}

model SellerSubscription {
  id String @id @default(cuid())
  status SellerSubscriptionStatus @default(PENDING)
  sellerId String
  planCode SellerPlanCode
  startsAt DateTime?
  currentPeriodEnd DateTime?
  cancelledAt DateTime?
  seller SellerProfile @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  plan SellerPlan @relation(fields: [planCode], references: [code])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([sellerId, status])
  @@index([planCode, status])
}

model Campaign {
  id String @id @default(cuid())
  name String
  objective CampaignObjective
  status CampaignStatus @default(DRAFT)
  audienceCountry String @default("Nigeria")
  audienceAgeMin Int @default(18)
  audienceAgeMax Int @default(44)
  audienceInterests String?
  dailyBudget Decimal @db.Decimal(12, 2)
  durationDays Int
  startsAt DateTime?
  endsAt DateTime?
  sellerId String
  productId String
  seller SellerProfile @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Restrict)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([sellerId, status, createdAt])
  @@index([productId])
}

model Address {
  id String @id @default(cuid())
  label String?
  line1 String
  line2 String?
  city String
  region String
  postalCode String
  country String
  isDefault Boolean @default(false)
  userId String
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  orders Order[]
  @@index([userId])
}

model SavedProduct {
  userId String
  productId String
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  @@id([userId, productId])
  @@index([productId])
}

model Follow {
  followerId String
  sellerId String
  follower User @relation("Follower", fields: [followerId], references: [id], onDelete: Cascade)
  seller User @relation("SellerFollowers", fields: [sellerId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  @@id([followerId, sellerId])
  @@index([sellerId])
}

model Notification {
  id String @id @default(cuid())
  type NotificationType
  title String
  body String
  readAt DateTime?
  userId String
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  @@index([userId, createdAt])
}

model Reel {
  id String @id @default(cuid())
  source ReelSource @default(EAZICART)
  status ReelStatus @default(PUBLISHED)
  caption String?
  videoUrl String?
  thumbnailUrl String?
  externalId String?
  externalUrl String?
  attribution String?
  sellerId String?
  productId String?
  seller SellerProfile? @relation(fields: [sellerId], references: [id], onDelete: SetNull)
  product Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
  likes ReelLike[]
  saves ReelSave[]
  views ReelView[]
  comments ReelComment[]
  publishedAt DateTime @default(now())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@unique([source, externalId])
  @@index([status, publishedAt])
  @@index([source, publishedAt])
  @@index([sellerId, publishedAt])
  @@index([productId])
}

model ReelLike {
  userId String
  reelId String
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  reel Reel @relation(fields: [reelId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  @@id([userId, reelId])
  @@index([reelId, createdAt])
}

model ReelSave {
  userId String
  reelId String
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  reel Reel @relation(fields: [reelId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  @@id([userId, reelId])
  @@index([reelId, createdAt])
}

model ReelView {
  id String @id @default(cuid())
  reelId String
  userId String?
  watchMs Int @default(0)
  completed Boolean @default(false)
  reel Reel @relation(fields: [reelId], references: [id], onDelete: Cascade)
  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)
  createdAt DateTime @default(now())
  @@index([reelId, createdAt])
  @@index([userId, createdAt])
}

model ReelComment {
  id String @id @default(cuid())
  body String
  reelId String
  userId String
  reel Reel @relation(fields: [reelId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([reelId, createdAt])
}
