{
  "name": "@eazicart/database",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "prisma generate && tsc -p tsconfig.build.json",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "test": "node --test",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:deploy": "prisma migrate deploy",
    "seed": "node --env-file=.env prisma/seed.mjs",
    "seed:ci": "node prisma/seed.mjs"
  },
  "dependencies": {
    "@prisma/client": "^6.16.1"
  },
  "devDependencies": {
    "@eazicart/config": "workspace:*",
    "eslint": "^9.35.0",
    "prisma": "^6.16.1",
    "typescript": "^5.9.2",
    "argon2": "^0.44.0"
  }
}
